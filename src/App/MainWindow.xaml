<Window
  x:Class="WinNativeFileU.Desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="WinNativeFileU — Foundation">
  <Grid Padding="32">
    <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="WinNativeFileU" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="Project foundation" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock TextWrapping="Wrap" Text="This diagnostic window verifies the application shell. Drag and drop, keyboard activation, radial actions and conversion are pending Windows feasibility testing." />
    </StackPanel>
  </Grid>
</Window>
